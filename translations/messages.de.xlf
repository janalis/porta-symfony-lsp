<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="de" datatype="plaintext" original="messages">
    <body>
      <trans-unit id="1">
        <source>symfony-lsp: downloading the latest release…</source>
        <target>symfony-lsp: neueste Version wird heruntergeladen…</target>
      </trans-unit>
      <trans-unit id="2">
        <source>symfony-lsp installed: %path%</source>
        <target>symfony-lsp installiert: %path%</target>
      </trans-unit>
      <trans-unit id="3">
        <source>symfony-lsp install failed: %why%</source>
        <target>symfony-lsp-Installation fehlgeschlagen: %why%</target>
      </trans-unit>
      <trans-unit id="4">
        <source>symfony-lsp: checking for a newer release…</source>
        <target>symfony-lsp: Suche nach einer neueren Version…</target>
      </trans-unit>
      <trans-unit id="5">
        <source>symfony-lsp updated: %from% → %to%</source>
        <target>symfony-lsp aktualisiert: %from% → %to%</target>
      </trans-unit>
      <trans-unit id="6">
        <source>symfony-lsp is already up to date (%version%)</source>
        <target>symfony-lsp ist bereits aktuell (%version%)</target>
      </trans-unit>
      <trans-unit id="7">
        <source>symfony-lsp update failed: %why%</source>
        <target>symfony-lsp-Aktualisierung fehlgeschlagen: %why%</target>
      </trans-unit>
      <trans-unit id="8">
        <source>symfony-lsp: resolving…</source>
        <target>symfony-lsp: Auflösen…</target>
      </trans-unit>
      <trans-unit id="9">
        <source>symfony-lsp: downloading…</source>
        <target>symfony-lsp: Herunterladen…</target>
      </trans-unit>
      <trans-unit id="10">
        <source>symfony-lsp: downloading %percent%%</source>
        <target>symfony-lsp: Herunterladen %percent%%</target>
      </trans-unit>
      <trans-unit id="11">
        <source>symfony-lsp: verifying…</source>
        <target>symfony-lsp: Überprüfen…</target>
      </trans-unit>
      <trans-unit id="12">
        <source>symfony-lsp: extracting…</source>
        <target>symfony-lsp: Entpacken…</target>
      </trans-unit>
      <trans-unit id="13">
        <source>symfony-lsp: checking the binary…</source>
        <target>symfony-lsp: Binärdatei wird geprüft…</target>
      </trans-unit>
      <trans-unit id="14">
        <source>symfony-lsp %version% is available — run "Symfony LSP: Update Server"</source>
        <target>symfony-lsp %version% ist verfügbar — führen Sie „Symfony LSP: Server aktualisieren“ aus</target>
      </trans-unit>
      <trans-unit id="15">
        <source>Check for a newer server once a day</source>
        <target>Einmal täglich nach einem neueren Server suchen</target>
      </trans-unit>
    </body>
