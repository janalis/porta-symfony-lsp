<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="ja" datatype="plaintext" original="messages">
    <body>
      <trans-unit id="1">
        <source>symfony-lsp: downloading the latest release…</source>
        <target>symfony-lsp: 最新リリースをダウンロード中…</target>
      </trans-unit>
      <trans-unit id="2">
        <source>symfony-lsp installed: %path%</source>
        <target>symfony-lsp をインストールしました: %path%</target>
      </trans-unit>
      <trans-unit id="3">
        <source>symfony-lsp install failed: %why%</source>
        <target>symfony-lsp のインストールに失敗しました: %why%</target>
      </trans-unit>
      <trans-unit id="4">
        <source>symfony-lsp: checking for a newer release…</source>
        <target>symfony-lsp: 新しいリリースを確認しています…</target>
      </trans-unit>
      <trans-unit id="5">
        <source>symfony-lsp updated: %from% → %to%</source>
        <target>symfony-lsp を更新しました: %from% → %to%</target>
      </trans-unit>
      <trans-unit id="6">
        <source>symfony-lsp is already up to date (%version%)</source>
        <target>symfony-lsp は最新です (%version%)</target>
      </trans-unit>
      <trans-unit id="7">
        <source>symfony-lsp update failed: %why%</source>
        <target>symfony-lsp の更新に失敗しました: %why%</target>
      </trans-unit>
      <trans-unit id="8">
        <source>symfony-lsp: resolving…</source>
        <target>symfony-lsp: 解決中…</target>
      </trans-unit>
      <trans-unit id="9">
        <source>symfony-lsp: downloading…</source>
        <target>symfony-lsp: ダウンロード中…</target>
      </trans-unit>
      <trans-unit id="10">
        <source>symfony-lsp: downloading %percent%%</source>
        <target>symfony-lsp: ダウンロード中 %percent%%</target>
      </trans-unit>
      <trans-unit id="11">
        <source>symfony-lsp: verifying…</source>
        <target>symfony-lsp: 検証中…</target>
      </trans-unit>
      <trans-unit id="12">
        <source>symfony-lsp: extracting…</source>
        <target>symfony-lsp: 展開中…</target>
      </trans-unit>
      <trans-unit id="13">
        <source>symfony-lsp: checking the binary…</source>
        <target>symfony-lsp: バイナリを確認中…</target>
      </trans-unit>
      <trans-unit id="14">
        <source>symfony-lsp %version% is available — run "Symfony LSP: Update Server"</source>
        <target>symfony-lsp %version% が利用可能です —「Symfony LSP: Update Server」を実行してください</target>
      </trans-unit>
      <trans-unit id="15">
        <source>Check for a newer server once a day</source>
        <target>新しいサーバーを 1 日 1 回確認する</target>
      </trans-unit>
    </body>
  </file>
</xliff>
